{
    "name": "raha/cloud-media-manager",
    "description": "Multi-cloud media storage for WordPress (R2, S3, B2, Google Drive) with JWT, queue, and multisite support.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "CMM\\": "src/",
            "CMM\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CMM\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":      "phpunit --testsuite Unit",
        "test-all":  "phpunit",
        "lint":      "php -l src/**/*.php database/**/*.php",
        "cs":        "phpcs --standard=WordPress src/ --extensions=php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
