# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── MySQL Database (Hostinger) ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456_cms
DB_USER=u123456_cms
DB_PASSWORD=your_strong_password

# ─── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=15m
# Refresh token TTL in milliseconds (default: 30 days)
JWT_REFRESH_EXPIRES_MS=2592000000

# ─── Encryption (for AI keys stored in DB) ────────────────
# Must be exactly 32 characters
ENCRYPTION_KEY=replace_with_32_char_random_key!!

# ─── WordPress ────────────────────────────────────────────
WP_URL=https://yoursite.com
WP_API_USER=your_wp_username
WP_API_PASSWORD=your_wp_application_password

# ─── AI Master Keys (optional — users can bring their own) ─
DAILY_AI_QUOTA=10
ADMIN_GEMINI_KEY=AIza...
ADMIN_OPENAI_KEY=sk-...
ADMIN_CLAUDE_KEY=sk-ant-...
ADMIN_DEEPSEEK_KEY=sk-...
ADMIN_GROK_KEY=xai-...
ADMIN_MISTRAL_KEY=...

# ─── Telegram (for daily backup delivery) ─────────────────
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=https://your-app-url.com
